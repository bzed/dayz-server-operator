set -e

# The debhelper marker below expands to, among others, the
# dh_installsysusers snippet, which runs systemd-sysusers to create the
# "dayz" user from packaging/common/dzo.sysusers (installed as
# debian/dzo.sysusers through a symlink). The shared post-install script
# below needs that user to already exist, so it must run after the
# expansion, not before - keep it below this point in the file.
#DEBHELPER#

# The post-install steps live in /usr/libexec/dzo/postinst so the rpm %post and
# the Arch .install hook run the same code (packaging/common/dzo-postinst.sh).
# dpkg calls "postinst configure" with an empty $2 on a fresh install and with
# the previously configured version on an upgrade; the script calls those
# "configure" and "upgrade". Both create the dayz user's data directory,
# subuid/subgid range and lingering; "upgrade" also refreshes the generated
# units and restarts dzo's own services.
if [ "$1" = "configure" ]; then
	if [ -n "$2" ]; then
		/usr/libexec/dzo/postinst upgrade
	else
		/usr/libexec/dzo/postinst configure
	fi
fi

exit 0
