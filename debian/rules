#!/usr/bin/make -f
# SPDX-FileCopyrightText: 2026 Bernd Zeimetz <bernd@bzed.de>
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# The build uses the upstream Go toolchain (§C0 of IMPLEMENTATION_PLAN.md),
# not Debian's golang-go, so `go` must already be on PATH when this runs -
# the CI job installs it before calling dpkg-buildpackage. Vendoring
# dependencies for a fully offline build (as the plan describes) is
# deferred (D35, lazy engineering) until a builder without network access
# actually needs it; today's CI jobs have network access to the Go module
# proxy.

export CGO_ENABLED = 0
# The build tree is not a git checkout the builder owns (a CI container, a source package).
export GOFLAGS = -buildvcs=false

# Force the plain "makefile" buildsystem: without this, dh's auto-detection
# picks "golang" on the presence of go.mod and pulls in dh-golang's
# GOPATH-style install step, which is exactly what the plan avoids.
%:
	dh $@ --buildsystem=makefile

override_dh_auto_build:
	$(MAKE) build servermods docs
	bin/dzo gen-man debian/man

override_dh_auto_test:
	# the coverage gate runs in the test job: this container has no btrfs, so tests that need it skip
	$(MAKE) test

override_dh_auto_clean:
	rm -rf debian/man
	$(MAKE) clean
	dh_auto_clean

# Nothing to do: the Makefile has no "install" target, and the binary/
# conffile placement is entirely handled by debian/dzo.install (dh_install).
override_dh_auto_install:
